recipes.remove(<singularities:compressor>);

recipes.addShaped("singularities_compressor", <singularities:compressor>, [
    [<ore:slateTier4>, <storagedrawers:compdrawers>, <ore:slateTier4>],
    [<ore:blockIridium>, g_blessedMachineFrame, <ore:blockIridium>],
    [<pneumaticcraft:advanced_pcb>, <ore:ingotTerrasteel>, <pneumaticcraft:advanced_pcb>]
]);

recipes.addShaped("soul_singularity", <singularities:singularity:12>, [
    [<quark:soul_powder>, <botania:enderdagger>, <quark:soul_powder>],
    [<botania:enderdagger>, <ore:singularityStellar>, <botania:enderdagger>],
    [<ore:blockSoularium>, <botania:enderdagger>, <ore:blockSoularium>]
]);